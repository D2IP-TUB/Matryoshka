# PostgreSQL connection for Matryoshka. Either set MATRYOSHKA_DSN, or the
# individual MATRYOSHKA_DB_* variables, or rely on the standard PG* variables.
# See matryoshka.db.settings for the full resolution order, and `matryoshka info`
# to check what resolves.
MATRYOSHKA_DSN=postgresql://postgres:postgres@localhost:5432/matryoshka

# MATRYOSHKA_DB_HOST=localhost
# MATRYOSHKA_DB_PORT=5432
# MATRYOSHKA_DB_NAME=matryoshka
# MATRYOSHKA_DB_USER=postgres
# MATRYOSHKA_DB_PASSWORD=postgres

# Where run logs and selection-history artefacts are written.
# Defaults to ./.matryoshka/logs
# MATRYOSHKA_LOG_DIR=/var/log/matryoshka
