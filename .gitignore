# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/

# Environments
.venv/
venv/
env/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# Matryoshka runtime output. `default_log_dir()` writes here unless
# MATRYOSHKA_LOG_DIR says otherwise.
.matryoshka/
*.log

# Local database credentials. Never commit these; see
# matryoshka.db.settings for the resolution order.
db_config.yaml
db_config.yml

# Example and benchmark data are downloaded or generated, never committed.
examples/*/data/
lake/
small_lake/
validation_lake/

# Generated baseline index artefacts. Rebuild with the scripts in each
# directory; see baselines/README.md.
baselines/discovery/Aurum/graphs/
baselines/discovery/DeepJoin/*_index/
baselines/augmenters/autofeat_og_utils/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
